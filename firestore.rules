rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin helper function
    // Admins can be designated either by a custom claim (request.auth.token.admin == true)
    // or by being listed in an 'admins' collection.
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection: strictly protected, only existing admins can read/write
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Users Collection
    // - Anyone authenticated can read user profiles (for swiping & discovering partners)
    // - A user can ONLY create, update, or delete their own profile document
    // - Attackers cannot modify other users' profiles, and cannot escalate themselves to admin
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'role']) || isAdmin())) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Swipes Collection
    // Document ID convention: {fromUid}_{toUid}
    // - A user can only record or read their own swipes
    // - To check for mutual matches, a user can read if the swipe was targeted to them
    match /swipes/{swipeId} {
      allow create, update: if isSignedIn() && request.resource.data.from == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.from == request.auth.uid;
    }

    // Matches Collection
    // Document ID: {uid1}_{uid2}
    // Contains array field: users (e.g. [uid1, uid2])
    // - Strictly only participants of the match can read or update the match document
    // - No outside attacker or non-participant can inspect matches
    match /matches/{matchId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.users || isAdmin());
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.users;
      allow update: if isSignedIn() && (request.auth.uid in resource.data.users || isAdmin());
      allow delete: if isAdmin();

      // Messages sub-collection:
      // match /matches/{matchId}/messages/{messageId}
      // - Only participants of the match can read chat messages
      // - A participant can only send a message where senderId == their own UID
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users || isAdmin()
        );
        allow create: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users &&
          request.resource.data.senderId == request.auth.uid
        );
        allow update, delete: if isAdmin();
      }
    }
  }
}
