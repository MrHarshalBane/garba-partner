rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidNumber(val, minVal, maxVal) {
      return val is number && val >= minVal && val <= maxVal;
    }

    function isValidList(val, maxItems) {
      return val is list && val.size() <= maxItems;
    }

    // Admin helper function
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection: strictly protected, only existing admins can read/write
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Users Collection
    // - Authenticated users can read public profiles for discovering partners
    // - A user can ONLY create, update, or delete their own profile document
    // - Strict schema validation: types, lengths, sanitize against escalation
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if (isOwner(userId) &&
        isValidString(request.resource.data.name, 1, 100) &&
        isValidNumber(request.resource.data.age, 18, 100) &&
        isValidString(request.resource.data.city, 1, 100) &&
        isValidString(request.resource.data.skill, 1, 50) &&
        isValidString(request.resource.data.looking, 1, 50) &&
        (!('bio' in request.resource.data) || isValidString(request.resource.data.bio, 0, 500)) &&
        (!('styles' in request.resource.data) || isValidList(request.resource.data.styles, 20)) &&
        (!('photoURL' in request.resource.data) || request.resource.data.photoURL == null || isValidString(request.resource.data.photoURL, 1, 2000000)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'role']) || isAdmin())
      ) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Swipes Collection
    // Document ID convention: {fromUid}_{toUid}
    // - Authenticated users can only record swipes where `from` == their own UID
    // - Prevents spoofing swipe sender or swiping on behalf of other accounts
    match /swipes/{swipeId} {
      allow create, update: if isSignedIn() &&
        request.resource.data.from == request.auth.uid &&
        isValidString(request.resource.data.to, 1, 128) &&
        request.resource.data.to != request.auth.uid &&
        request.resource.data.action in ['like', 'right', 'super', 'pass', 'left'];
      allow read: if isSignedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.from == request.auth.uid;
    }

    // Matches Collection
    // Document ID: {uid1}_{uid2}
    // Users array must contain authenticated user; prevents tampering or snooping
    match /matches/{matchId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.users || isAdmin());
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.users &&
        request.resource.data.users.size() == 2;
      allow update: if isSignedIn() && (request.auth.uid in resource.data.users || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid in resource.data.users || isAdmin());

      // Messages sub-collection
      // Only validated participants can read or append messages; senderId strictly checked
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users || isAdmin()
        );
        allow create: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users &&
          request.resource.data.senderId == request.auth.uid &&
          isValidString(request.resource.data.text, 1, 2000)
        );
        allow update, delete: if isAdmin();
      }
    }
  }
}
